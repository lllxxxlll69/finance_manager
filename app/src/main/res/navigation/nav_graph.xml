<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.financemanager.HomeFragment"
        android:label="Главная"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_addExpenseFragment"
            app:destination="@id/addExpenseFragment" />

    </fragment>

    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.example.financemanager.AddExpenseFragment"
        android:label="Добавить расход"
        tools:layout="@layout/fragment_add_expense" />

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.example.financemanager.CategoriesFragment"
        android:label="Категории"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.financemanager.StatsFragment"
        android:label="Статистика"
        tools:layout="@layout/fragment_stats" />

</navigation>